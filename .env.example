MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=CompanionBot
MC_AUTH=offline
# 可选：仅响应这些玩家，多个名称以逗号分隔；留空则响应所有人
MC_ALLOWED_PLAYERS=
# 语音控制的孩子游戏名；跟随、带路、保护均以此玩家为对象
MC_COMPANION_PLAYER=

# 本地语音控制页只会监听 127.0.0.1
VOICE_PORT=8787

# 任意 OpenAI 兼容的聊天接口；不填密钥时只支持基础本地口令
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Jev 负责从安全动作中做实时选择。未配置时使用保守规则降级。
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.85

# 陪玩人设
PERSONA_NAME=阿搭
PERSONA_STYLE=可靠的小伙伴，简短、友善、鼓励式，不说教
